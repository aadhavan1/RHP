#include <iostream>
#include<vector>
using namespace std;
int main()
{
    int n;
    cin>>n;
    vector<int> arr(n);
    int oc=0;
    for(int i=0;i<n;i++){
        cin>>arr[i];
        if(arr[i]==1){
            oc++;
        }
        
    }
    int zc=n-oc;
    if(zc<2){
        cout<<"-1"<<endl;
        return 0;
    }
    int ans=0;
    if(arr[0]==1) ans++;
    if(arr[n-1]==1) ans++;
    cout<<ans<<endl;
}
